# ----- Skill Swap University : Frontend Environment -----
# Copy this file to `.env` ONLY if you need to override defaults.
# In development the Vite dev server proxies /api, /uploads and /socket.io to
# the backend, so no variables are required for local development.

# Full base URL for API calls. Leave unset to use the "/api" proxy.
# Example (separate backend host): VITE_API_URL=https://api.example.com/api
# VITE_API_URL=

# Socket.IO server URL. Leave unset to connect to the current origin (proxy).
# VITE_SOCKET_URL=

# Vite proxy target (used by vite.config.js during `npm run dev`).
# VITE_PROXY_TARGET=http://localhost:5000
