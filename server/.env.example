# ----- Skill Swap University : Backend Environment -----
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/skill_swap_university
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/skill_swap_university?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Single-campus identity (academic prototype)
CAMPUS_NAME=Skill Swap University
# Comma separated list of allowed student email domains. Leave empty to allow any.
ALLOWED_EMAIL_DOMAINS=
# When true, the domain check is skipped and any email is accepted.
# Keep true for demos/local development, otherwise registration is limited to
# the domains listed above (e.g. set false with ALLOWED_EMAIL_DOMAINS=student.ssu.edu).
ALLOW_ANY_EMAIL=true

# AI skill verification
# If AI_PROVIDER=openai and OPENAI_API_KEY is set, real AI assessment is used.
# Otherwise the backend falls back to a transparent "demo" assessment.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PASS_THRESHOLD=70

# AI illustration generation (optional) — used by `npm run art`.
# Generates the cinematic campus hero image and the anime student portraits.
# Requires ART_IMAGE_PROVIDER=openai and OPENAI_API_KEY (reused above).
ART_IMAGE_PROVIDER=openai
ART_IMAGE_MODEL=gpt-image-1
# Hero aspect is landscape; portraits are square.
ART_IMAGE_SIZE_HERO=1536x1024
ART_IMAGE_SIZE_AVATAR=1024x1024
# gpt-image-1: low | medium | high ; dall-e-3: standard | hd
ART_IMAGE_QUALITY=high
# gpt-image-1 supports png | jpeg | webp (webp is smallest).
ART_IMAGE_OUTPUT_FORMAT=webp

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
